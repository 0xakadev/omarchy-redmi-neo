#!/usr/bin/python3
"""Background daemon for Omarchy REDMI Headphones Neo plugin (0xakadev.redmi-neo).

Maintains:
- BlueZ D-Bus state discovery (Connected, Battery1, ManufacturerData 0xFFFF/0x1727, paired devices)
- RFCOMM RCSP persistent connection with SAFER+ mutual authentication
- Real-time push notifications from the headphones (OP_REPORT_STATUS 0x0E & OP_NOTIFY_CONFIG 0xF4)
- Local Unix domain socket IPC ($XDG_RUNTIME_DIR/redmi-neo.sock) with SO_PEERCRED UID verification
"""

from __future__ import annotations

import os
import socket
import sys

sys.dont_write_bytecode = True

# Ensure system Python with Bluetooth & D-Bus bindings is used even if invoked via mise/pyenv python3
if __name__ == "__main__" and not hasattr(socket, "AF_BLUETOOTH") and os.path.exists("/usr/bin/python3"):
    os.execv("/usr/bin/python3", ["/usr/bin/python3"] + sys.argv)

import concurrent.futures
import ctypes
import json
import re
import signal
import stat
import struct
import subprocess
import tempfile
import threading
import time
from pathlib import Path
from typing import Any

SCRIPT_DIR = Path(__file__).resolve().parent
if str(SCRIPT_DIR) not in sys.path:
    sys.path.insert(0, str(SCRIPT_DIR))

import protocol  # noqa: E402

try:
    import dbus  # type: ignore
except ImportError:
    dbus = None


# ── Paths & Security Helpers ──

def runtime_socket_path() -> Path:
    xdg = os.environ.get("XDG_RUNTIME_DIR")
    if xdg:
        base = Path(xdg)
    else:
        base = Path(f"/run/user/{os.getuid()}")
    return base / "redmi-neo.sock"


def config_file_path() -> Path:
    xdg = os.environ.get("XDG_CONFIG_HOME")
    base = Path(xdg) if xdg else (Path.home() / ".config")
    return base / "omarchy-redmi-neo" / "config.json"


def _safe_mkdir(path: Path) -> None:
    path.mkdir(parents=True, exist_ok=True, mode=0o700)
    st = os.lstat(path)
    if stat.S_ISLNK(st.st_mode):
        raise RuntimeError(f"Refusing symlink directory: {path}")


def load_config() -> dict[str, Any]:
    path = config_file_path()
    fd: int | None = None
    fd_owned = False
    try:
        flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0)
        fd = os.open(str(path), flags)
        fh = os.fdopen(fd, "r", encoding="utf-8")
        fd_owned = True
        with fh:
            data = json.load(fh)
            return data if isinstance(data, dict) else {}
    except FileNotFoundError:
        return {}
    except Exception:
        return {}
    finally:
        if fd is not None and not fd_owned:
            try:
                os.close(fd)
            except OSError:
                pass


def save_config(data: dict[str, Any]) -> None:
    path = config_file_path()
    try:
        _safe_mkdir(path.parent)
        fd, tmp_name = tempfile.mkstemp(prefix=".config.", dir=str(path.parent))
        fd_owned = False
        try:
            os.fchmod(fd, 0o600)
            fh = os.fdopen(fd, "w", encoding="utf-8")
            fd_owned = True
            with fh:
                json.dump(data, fh, indent=2, sort_keys=True)
                fh.flush()
                os.fsync(fh.fileno())
            if path.exists() and path.is_symlink():
                raise RuntimeError(f"Refusing to overwrite symlink config: {path}")
            os.replace(tmp_name, str(path))
        finally:
            if not fd_owned:
                try:
                    os.close(fd)
                except OSError:
                    pass
            if os.path.exists(tmp_name):
                try:
                    os.unlink(tmp_name)
                except OSError:
                    pass
    except Exception:
        pass


def verify_peer_uid(conn: socket.socket) -> bool:
    """Verifies via SO_PEERCRED that the client socket belongs to the same Unix UID."""
    try:
        so_peercred = getattr(socket, "SO_PEERCRED", 17)
        creds = conn.getsockopt(socket.SOL_SOCKET, so_peercred, struct.calcsize("3i"))
        _pid, uid, _gid = struct.unpack("3i", creds)
        return uid == os.getuid()
    except Exception:
        return False


# ── SDP RFCOMM Channel Resolver (via libbluetooth.so.3) ──

class _bdaddr_t(ctypes.Structure):
    _fields_ = [("b", ctypes.c_uint8 * 6)]


class _uuid_val(ctypes.Union):
    _fields_ = [
        ("uuid16", ctypes.c_uint16),
        ("uuid32", ctypes.c_uint32),
        ("uuid128", ctypes.c_uint8 * 16),
    ]


class _uuid_t(ctypes.Structure):
    _fields_ = [
        ("type", ctypes.c_uint8),
        ("value", _uuid_val),
    ]


class _sdp_list_t(ctypes.Structure):
    pass


_sdp_list_t._fields_ = [
    ("next", ctypes.POINTER(_sdp_list_t)),
    ("data", ctypes.c_void_p),
]

RFCOMM_UUID = 0x0003
SDP_ATTR_REQ_RANGE = 0x0002
SDP_ATTR_PROTO_DESC_LIST = 0x0004


def _free_sdp_proto_list(libbt: Any, proto_list: Any) -> None:
    """Frees both inner protocol descriptor sub-lists and the outer access-proto list."""
    if not proto_list:
        return
    curr = proto_list
    while curr:
        inner = curr.contents.data
        if inner:
            libbt.sdp_list_free(ctypes.cast(inner, ctypes.POINTER(_sdp_list_t)), None)
        curr = curr.contents.next
    libbt.sdp_list_free(proto_list, None)


def _free_sdp_record_list(libbt: Any, seq_list: Any) -> None:
    """Frees every remaining allocated `sdp_record_t` in `seq_list` and then frees `seq_list`."""
    if not seq_list:
        return
    curr = seq_list
    while curr:
        rec = curr.contents.data
        if rec:
            libbt.sdp_record_free(rec)
            curr.contents.data = None
        curr = curr.contents.next
    libbt.sdp_list_free(seq_list, None)


_LIBBT_LOCK = threading.Lock()
_LIBBT_HANDLE: Any = None
_LIBBT_FAILED = False


def _configure_libbt(libbt: Any) -> None:
    libbt.sdp_connect.argtypes = [ctypes.POINTER(_bdaddr_t), ctypes.POINTER(_bdaddr_t), ctypes.c_uint32]
    libbt.sdp_connect.restype = ctypes.c_void_p
    libbt.sdp_close.argtypes = [ctypes.c_void_p]
    libbt.sdp_uuid128_create.argtypes = [ctypes.POINTER(_uuid_t), ctypes.c_void_p]
    libbt.sdp_uuid16_create.argtypes = [ctypes.POINTER(_uuid_t), ctypes.c_uint16]
    libbt.sdp_list_append.argtypes = [ctypes.POINTER(_sdp_list_t), ctypes.c_void_p]
    libbt.sdp_list_append.restype = ctypes.POINTER(_sdp_list_t)
    libbt.sdp_list_free.argtypes = [ctypes.POINTER(_sdp_list_t), ctypes.c_void_p]
    libbt.sdp_service_search_attr_req.argtypes = [
        ctypes.c_void_p,
        ctypes.POINTER(_sdp_list_t),
        ctypes.c_int,
        ctypes.POINTER(_sdp_list_t),
        ctypes.POINTER(ctypes.POINTER(_sdp_list_t)),
    ]
    libbt.sdp_service_search_attr_req.restype = ctypes.c_int
    libbt.sdp_get_access_protos.argtypes = [ctypes.c_void_p, ctypes.POINTER(ctypes.POINTER(_sdp_list_t))]
    libbt.sdp_get_access_protos.restype = ctypes.c_int
    libbt.sdp_get_proto_port.argtypes = [ctypes.POINTER(_sdp_list_t), ctypes.c_int]
    libbt.sdp_get_proto_port.restype = ctypes.c_int
    libbt.sdp_record_free.argtypes = [ctypes.c_void_p]


def _get_libbt() -> Any:
    """Loads and configures libbluetooth.so.3 exactly once per daemon process.

    Re-running `ctypes.CDLL()` on every lookup bumps the dlopen() reference count without
    a matching dlclose(), so the handle is cached for the life of the daemon instead.
    """
    global _LIBBT_HANDLE, _LIBBT_FAILED
    with _LIBBT_LOCK:
        if _LIBBT_HANDLE is None and not _LIBBT_FAILED:
            try:
                handle = ctypes.CDLL("libbluetooth.so.3")
                _configure_libbt(handle)
                _LIBBT_HANDLE = handle
            except (OSError, AttributeError):
                _LIBBT_FAILED = True
        return _LIBBT_HANDLE


def sdp_find_rfcomm_channel(mac: str, uuid_str: str, libbt: Any = None) -> int | None:
    """Queries the remote Bluetooth device SDP server for the RFCOMM channel of `uuid_str`."""
    if libbt is None:
        libbt = _get_libbt()
        if libbt is None:
            return None
    else:
        _configure_libbt(libbt)

    try:
        parts = [int(x, 16) for x in mac.split(":")]
        if len(parts) != 6:
            return None
        bd_any = _bdaddr_t((ctypes.c_uint8 * 6)(0, 0, 0, 0, 0, 0))
        bd_dst = _bdaddr_t((ctypes.c_uint8 * 6)(*reversed(parts)))

        session = libbt.sdp_connect(ctypes.byref(bd_any), ctypes.byref(bd_dst), 0)
        if not session:
            return None

        try:
            u = _uuid_t()
            raw_uuid = bytes.fromhex(uuid_str.replace("-", ""))
            libbt.sdp_uuid128_create(ctypes.byref(u), raw_uuid)

            search_list = ctypes.POINTER(_sdp_list_t)()
            attrid_list = ctypes.POINTER(_sdp_list_t)()
            seq_list = ctypes.POINTER(_sdp_list_t)()
            attr_range = ctypes.c_uint32((SDP_ATTR_PROTO_DESC_LIST << 16) | SDP_ATTR_PROTO_DESC_LIST)
            try:
                search_list = libbt.sdp_list_append(None, ctypes.byref(u))
                attrid_list = libbt.sdp_list_append(None, ctypes.byref(attr_range))
                err = libbt.sdp_service_search_attr_req(
                    session,
                    search_list,
                    SDP_ATTR_REQ_RANGE,
                    attrid_list,
                    ctypes.byref(seq_list),
                )
            finally:
                if search_list:
                    libbt.sdp_list_free(search_list, None)
                if attrid_list:
                    libbt.sdp_list_free(attrid_list, None)

            if err != 0 or not seq_list:
                _free_sdp_record_list(libbt, seq_list)
                return None

            channel: int | None = None
            try:
                curr = seq_list
                while curr:
                    rec = curr.contents.data
                    if rec:
                        try:
                            if channel is None:
                                proto_list = ctypes.POINTER(_sdp_list_t)()
                                try:
                                    if libbt.sdp_get_access_protos(rec, ctypes.byref(proto_list)) == 0 and proto_list:
                                        port = libbt.sdp_get_proto_port(proto_list, RFCOMM_UUID)
                                        if 0 < port <= 30:
                                            channel = int(port)
                                finally:
                                    _free_sdp_proto_list(libbt, proto_list)
                        finally:
                            libbt.sdp_record_free(rec)
                            curr.contents.data = None
                    curr = curr.contents.next
            finally:
                _free_sdp_record_list(libbt, seq_list)
            return channel
        finally:
            libbt.sdp_close(session)
    except Exception:
        return None


# ── BlueZ & PipeWire Helpers ──

def is_redmi_neo_candidate(dev: dict[str, Any]) -> bool:
    name = (dev.get("name") or "").lower()
    alias = (dev.get("alias") or "").lower()
    if "redmi" in name or "redmi" in alias or "xiaomi" in name or "miwear" in name:
        return True
    if dev.get("pid") == "50f0" or dev.get("vid") == "2717":
        return True
    uuids = [u.lower() for u in (dev.get("uuids") or [])]
    if protocol.UUID_MIUI_SPP in uuids or protocol.UUID_XIAOMI_MMA in uuids:
        return True
    return False


_DBUS_LOCK = threading.Lock()
_SYSTEM_BUS: Any = None


def _get_system_bus() -> Any:
    """Returns a cached SystemBus handle. Callers must hold `_DBUS_LOCK`."""
    global _SYSTEM_BUS
    if dbus is None:
        return None
    if _SYSTEM_BUS is None:
        _SYSTEM_BUS = dbus.SystemBus(private=False)
    return _SYSTEM_BUS


def query_bluez_devices() -> list[dict[str, Any]]:
    """Returns all paired/known Bluetooth devices from BlueZ via D-Bus.

    Uses `bus.call_blocking` under `_DBUS_LOCK` rather than `bus.get_object()` so
    `dbus-python` never spawns async `Introspect()` calls or races across threads.
    """
    if dbus is None:
        return []
    devices: list[dict[str, Any]] = []
    try:
        with _DBUS_LOCK:
            bus = _get_system_bus()
            if bus is None:
                return []
            objects = bus.call_blocking(
                "org.bluez",
                "/",
                "org.freedesktop.DBus.ObjectManager",
                "GetManagedObjects",
                "",
                (),
                timeout=2.0,
            )
        for path, ifaces in objects.items():
            dev_props = ifaces.get("org.bluez.Device1")
            if not dev_props:
                continue
            mac = str(dev_props.get("Address", "")).upper()
            if not mac:
                continue
            name = str(dev_props.get("Name", "") or dev_props.get("Alias", "") or mac)
            alias = str(dev_props.get("Alias", "") or name)
            connected = bool(dev_props.get("Connected", False))
            paired = bool(dev_props.get("Paired", False))
            uuids = [str(u).lower() for u in dev_props.get("UUIDs", [])]

            # Parse ManufacturerData if present
            mfg_raw: dict[int, bytes] = {}
            if "ManufacturerData" in dev_props:
                for k, v in dev_props["ManufacturerData"].items():
                    try:
                        mfg_raw[int(k)] = bytes(int(b) for b in v)
                    except Exception:
                        pass
            mfg_parsed = protocol.parse_manufacturer_data(mfg_raw)

            # Check org.bluez.Battery1 if exposed
            batt_props = ifaces.get("org.bluez.Battery1")
            bluez_battery: int | None = None
            if batt_props and "Percentage" in batt_props:
                try:
                    bluez_battery = int(batt_props["Percentage"])
                except Exception:
                    bluez_battery = None

            item: dict[str, Any] = {
                "path": str(path),
                "mac": mac,
                "name": name,
                "alias": alias,
                "connected": connected,
                "paired": paired,
                "uuids": uuids,
                "bluez_battery": bluez_battery,
                "beacon_battery": mfg_parsed.get("battery"),
                "beacon_charging": mfg_parsed.get("charging", False),
                "vid": mfg_parsed.get("vid"),
                "pid": mfg_parsed.get("pid"),
            }
            item["is_redmi_neo"] = is_redmi_neo_candidate(item)
            devices.append(item)
    except Exception:
        with _DBUS_LOCK:
            global _SYSTEM_BUS
            _SYSTEM_BUS = None
    return devices


def query_audio_codec(mac: str) -> dict[str, str | None]:
    """Queries PipeWire / PulseAudio (`pactl`) for the active Bluetooth audio codec and profile."""
    if not mac:
        return {"codec": None, "profile": None}
    mac_underscored = mac.upper().replace(":", "_")
    try:
        proc = subprocess.run(
            ["pactl", "list", "cards"],
            capture_output=True,
            text=True,
            timeout=1.5,
            check=False,
        )
        if proc.returncode != 0 or not proc.stdout:
            return {"codec": None, "profile": None}
        blocks = proc.stdout.split("Card #")
        for blk in blocks:
            if mac_underscored not in blk.upper():
                continue
            codec: str | None = None
            profile: str | None = None
            m_codec = re.search(r'api\.bluez5\.codec\s*=\s*"([^"]+)"', blk)
            if m_codec:
                codec = m_codec.group(1).upper().replace("_", "-")
            m_prof = re.search(r"Active Profile:\s*([^\n]+)", blk)
            if m_prof:
                raw_prof = m_prof.group(1).strip()
                if "a2dp" in raw_prof.lower():
                    profile = "A2DP"
                elif "headset" in raw_prof.lower() or "hfp" in raw_prof.lower():
                    profile = "HFP"
                elif raw_prof and raw_prof != "off":
                    profile = raw_prof
                if not codec and "codec-" in raw_prof.lower():
                    codec = raw_prof.split("codec-", 1)[1].upper().replace("_", "-")
                if not codec and raw_prof and raw_prof != "off":
                    m_desc = re.search(
                        rf"^\s*{re.escape(raw_prof)}:\s*.*?\bcodec\s+([A-Za-z0-9_-]+)",
                        blk,
                        re.IGNORECASE | re.MULTILINE,
                    )
                    if m_desc:
                        codec = m_desc.group(1).upper().replace("_", "-")
            return {"codec": codec, "profile": profile}
    except Exception:
        pass
    return {"codec": None, "profile": None}


def _read_sysfs_text(path: Path) -> str | None:
    try:
        return path.read_text(encoding="utf-8", errors="ignore").strip()
    except OSError:
        return None


def _format_sample_rate_khz(hz: int) -> str:
    if hz <= 0:
        return ""
    if hz % 1000 == 0:
        return f"{hz // 1000}kHz"
    khz = hz / 1000.0
    return f"{khz:.1f}kHz"


def query_usb_redmi_neo(sysfs_usb_root: Path = Path("/sys/bus/usb/devices")) -> dict[str, Any] | None:
    """Detects REDMI Headphones Neo (VID 0x2717 / PID 0x50F0) connected via USB-C cable."""
    target_vid = f"{protocol.VENDOR_ID:04x}"
    target_pid = f"{protocol.PRODUCT_ID:04x}"
    try:
        if not sysfs_usb_root.exists():
            return None
        for entry in sorted(sysfs_usb_root.iterdir(), key=lambda p: p.name):
            if ":" in entry.name or not entry.is_dir():
                continue
            vid = (_read_sysfs_text(entry / "idVendor") or "").lower()
            pid = (_read_sysfs_text(entry / "idProduct") or "").lower()
            if vid != target_vid or pid != target_pid:
                continue
            authorized = _read_sysfs_text(entry / "authorized")
            if authorized == "0":
                continue
            return {
                "vid": vid,
                "pid": pid,
                "product": _read_sysfs_text(entry / "product") or protocol.DEVICE_NAME_DEFAULT,
                "manufacturer": _read_sysfs_text(entry / "manufacturer"),
                "serial": _read_sysfs_text(entry / "serial"),
                "bcd_device": _read_sysfs_text(entry / "bcdDevice"),
                "max_power": _read_sysfs_text(entry / "bMaxPower"),
                "sysfs_path": str(entry),
            }
    except OSError:
        return None
    return None


def _parse_alsa_stream0(text: str) -> dict[str, str | None]:
    """Extracts active or preferred playback bit depth and sample rate from ALSA `stream0`."""
    if not text:
        return {"codec": None, "status": None}
    lines = text.splitlines()
    playback_lines: list[str] = []
    in_playback = False
    for line in lines:
        stripped = line.strip()
        if stripped.startswith("Playback:"):
            in_playback = True
            continue
        if in_playback and stripped.startswith("Capture:"):
            break
        if in_playback:
            playback_lines.append(line)

    pb_text = "\n".join(playback_lines)
    if not pb_text:
        return {"codec": None, "status": None}

    status_match = re.search(r"Status:\s*(\w+)", pb_text)
    status = status_match.group(1) if status_match else None
    active_alt_m = re.search(r"Altset\s*=\s*(\d+)", pb_text)
    active_alt = active_alt_m.group(1) if active_alt_m else None
    freq_m = re.search(r"Momentary freq\s*=\s*(\d+)\s*Hz", pb_text)
    freq_hz = int(freq_m.group(1)) if freq_m else None

    altsets: dict[str, tuple[int | None, int | None]] = {}
    cur_alt: str | None = None
    for line in playback_lines:
        m_alt = re.match(r"^\s*Altset\s+(\d+)\s*$", line)
        if m_alt:
            cur_alt = m_alt.group(1)
            altsets.setdefault(cur_alt, (None, None))
            continue
        if cur_alt is not None:
            bits, default_rate = altsets[cur_alt]
            m_bits = re.search(r"\bBits:\s*(\d+)", line)
            if m_bits:
                bits = int(m_bits.group(1))
            m_rates = re.search(r"\bRates:\s*([0-9,\s]+)", line)
            if m_rates:
                rates = [int(r) for r in re.findall(r"\d+", m_rates.group(1))]
                if 48000 in rates:
                    default_rate = 48000
                elif rates:
                    default_rate = rates[0]
            altsets[cur_alt] = (bits, default_rate)

    chosen_bits: int | None = None
    chosen_rate: int | None = freq_hz
    if active_alt and active_alt in altsets:
        chosen_bits, alt_rate = altsets[active_alt]
        if chosen_rate is None:
            chosen_rate = alt_rate
    elif altsets:
        best_alt = max(altsets.values(), key=lambda pair: pair[0] or 0)
        chosen_bits, alt_rate = best_alt
        if chosen_rate is None:
            chosen_rate = alt_rate

    if chosen_bits and chosen_rate:
        codec = f"PCM {chosen_bits}-bit/{_format_sample_rate_khz(chosen_rate)}"
    elif chosen_bits:
        codec = f"PCM {chosen_bits}-bit"
    elif chosen_rate:
        codec = f"PCM {_format_sample_rate_khz(chosen_rate)}"
    else:
        codec = None
    return {"codec": codec, "status": status}


def _parse_pactl_usb_audio(
    sinks_stdout: str,
    cards_stdout: str = "",
    default_sink: str = "",
) -> dict[str, Any]:
    """Extracts PipeWire USB audio format, profile, volume, mute, and default status for 2717:50F0."""
    codec: str | None = None
    profile: str | None = None
    sink_name: str | None = None
    volume_pct: int | None = None
    muted = False
    is_default = False

    for blk in (sinks_stdout or "").split("Sink #"):
        low = blk.lower()
        if not (
            ('device.vendor.id = "0x2717"' in low and 'device.product.id = "0x50f0"' in low)
            or ("redmi headphones neo" in low and 'device.bus = "usb"' in low)
        ):
            continue
        m_name = re.search(r"^\s*Name:\s*([^\n]+)", blk, re.MULTILINE)
        if m_name:
            sink_name = m_name.group(1).strip()
            is_default = bool(default_sink and sink_name == default_sink.strip())
        m_spec = re.search(r"Sample Specification:\s*([A-Za-z0-9_]+)\s+\d+ch\s+(\d+)Hz", blk)
        if m_spec:
            fmt = m_spec.group(1).lower()
            hz = int(m_spec.group(2))
            bits_m = re.search(r"(\d+)", fmt)
            bits = int(bits_m.group(1)) if bits_m else None
            if bits and hz:
                codec = f"PCM {bits}-bit/{_format_sample_rate_khz(hz)}"
            elif bits:
                codec = f"PCM {bits}-bit"
        m_mute = re.search(r"^\s*Mute:\s*(yes|no)", blk, re.IGNORECASE | re.MULTILINE)
        if m_mute:
            muted = m_mute.group(1).lower() == "yes"
        m_vol = re.search(r"^\s*Volume:[^\n]*?(\d+)%", blk, re.MULTILINE)
        if m_vol:
            volume_pct = max(0, min(150, int(m_vol.group(1))))
        break

    for blk in (cards_stdout or "").split("Card #"):
        low = blk.lower()
        if not (
            ('device.vendor.id = "0x2717"' in low and 'device.product.id = "0x50f0"' in low)
            or ("redmi headphones neo" in low and 'device.bus = "usb"' in low)
        ):
            continue
        m_prof = re.search(r"Active Profile:\s*([^\n]+)", blk)
        if m_prof:
            raw_prof = m_prof.group(1).strip().lower()
            if "output:" in raw_prof and "input:" in raw_prof:
                profile = "USB-C Duplex"
            elif "output:" in raw_prof:
                profile = "USB-C Audio"
            elif raw_prof and raw_prof != "off":
                profile = "USB-C"
        break

    return {
        "codec": codec,
        "profile": profile,
        "sink_name": sink_name,
        "volume": volume_pct,
        "muted": muted,
        "is_default": is_default,
    }


def query_usb_audio_info(
    asound_root: Path = Path("/proc/asound"),
    use_pactl: bool = True,
) -> dict[str, Any]:
    """Queries ALSA `/proc/asound` and PipeWire (`pactl`) for wired USB-C audio format, profile, and sink state."""
    target_usbid = f"{protocol.VENDOR_ID:04x}:{protocol.PRODUCT_ID:04x}"
    alsa_codec: str | None = None
    alsa_running = False

    try:
        if asound_root.exists():
            for card_dir in sorted(asound_root.glob("card*"), key=lambda p: p.name):
                if not card_dir.is_dir():
                    continue
                usbid = (_read_sysfs_text(card_dir / "usbid") or "").lower()
                if usbid != target_usbid:
                    continue
                stream_txt = _read_sysfs_text(card_dir / "stream0") or ""
                parsed = _parse_alsa_stream0(stream_txt)
                alsa_codec = parsed.get("codec")
                alsa_running = parsed.get("status") == "Running"
                break
    except OSError:
        pass

    pw_info: dict[str, Any] = {}
    if use_pactl:
        try:
            sinks_proc = subprocess.run(
                ["pactl", "list", "sinks"],
                capture_output=True,
                text=True,
                timeout=1.5,
                check=False,
            )
            cards_proc = subprocess.run(
                ["pactl", "list", "cards"],
                capture_output=True,
                text=True,
                timeout=1.5,
                check=False,
            )
            def_proc = subprocess.run(
                ["pactl", "get-default-sink"],
                capture_output=True,
                text=True,
                timeout=1.0,
                check=False,
            )
            pw_info = _parse_pactl_usb_audio(
                sinks_proc.stdout if sinks_proc.returncode == 0 else "",
                cards_proc.stdout if cards_proc.returncode == 0 else "",
                def_proc.stdout if def_proc.returncode == 0 else "",
            )
        except Exception:
            pass

    pw_codec = pw_info.get("codec")
    pw_profile = pw_info.get("profile")
    codec = alsa_codec if (alsa_running and alsa_codec) else (pw_codec or alsa_codec or "USB Audio")
    profile = pw_profile or "USB-C"
    return {
        "codec": codec,
        "profile": profile,
        "sink_name": pw_info.get("sink_name"),
        "volume": pw_info.get("volume"),
        "muted": bool(pw_info.get("muted", False)),
        "is_default": bool(pw_info.get("is_default", False)),
    }


def bluez_connect_device(mac: str, connect: bool) -> tuple[bool, str | None]:
    """Connects or disconnects the device via BlueZ D-Bus (with bluetoothctl fallback)."""
    action = "connect" if connect else "disconnect"
    if dbus is not None:
        try:
            dev_path: str | None = None
            with _DBUS_LOCK:
                bus = _get_system_bus()
                if bus is not None:
                    objects = bus.call_blocking(
                        "org.bluez",
                        "/",
                        "org.freedesktop.DBus.ObjectManager",
                        "GetManagedObjects",
                        "",
                        (),
                        timeout=2.0,
                    )
                    for path, ifaces in objects.items():
                        dev_props = ifaces.get("org.bluez.Device1")
                        if dev_props and str(dev_props.get("Address", "")).upper() == mac.upper():
                            dev_path = str(path)
                            break
                if bus is not None and dev_path is not None:
                    bus.call_blocking(
                        "org.bluez",
                        dev_path,
                        "org.bluez.Device1",
                        "Connect" if connect else "Disconnect",
                        "",
                        (),
                        timeout=12.0 if connect else 6.0,
                    )
                    return True, None
        except Exception as exc:
            err_msg = str(exc)
            # Fall through to bluetoothctl if D-Bus call timed out or raised
            try:
                proc = subprocess.run(
                    ["bluetoothctl", action, mac],
                    capture_output=True,
                    text=True,
                    timeout=10,
                    check=False,
                )
                if proc.returncode == 0 or "successful" in (proc.stdout or "").lower():
                    return True, None
            except Exception:
                pass
            return False, err_msg

    try:
        proc = subprocess.run(
            ["bluetoothctl", action, mac],
            capture_output=True,
            text=True,
            timeout=10,
            check=False,
        )
        if proc.returncode == 0:
            return True, None
        return False, (proc.stderr or proc.stdout or f"bluetoothctl {action} failed").strip()
    except Exception as exc:
        return False, str(exc)


# ── REDMI Headphones Neo Daemon State & RFCOMM Controller ──

DEFAULT_GESTURES = {
    "single": "play_pause",
    "double": "next",
    "triple": "previous",
    "long": "anc_cycle",
}


class RedmiNeoDaemon:
    DSP_SETTLE_SEC = 0.9
    POLL_QUIET_AFTER_WRITE_SEC = 2.2

    def __init__(self) -> None:
        self._lock = threading.RLock()
        self._refresh_lock = threading.Lock()
        self._write_lock = threading.Lock()
        self._cfg = load_config()
        self._seq = 0
        self._rfcomm_sock: socket.socket | None = None
        self._rfcomm_mac: str | None = None
        self._rfcomm_channel: int | None = None
        self._rfcomm_is_fastpair = False
        self._rfcomm_authenticated = False
        self._connecting_rfcomm = False
        self._last_rfcomm_attempt = 0.0
        self._last_bluez_refresh = 0.0
        self._last_bluez_devices: list[dict[str, Any]] = []
        self._last_codec_check = 0.0
        self._last_usb_audio_check = 0.0
        # Monotonic time of the latest user write *intent* (set before the optimistic state
        # update). Any read whose request left before this instant carries pre-write data.
        self._last_write_ts = 0.0
        # seq -> monotonic send time of every outstanding read request on the RCSP session.
        self._pending_reads: dict[int, float] = {}
        # Deferred CFG_TRANS_MODE (0x23) write when transitioning into Transparency from Off/ANC
        # (firmware ignores 0x23 until the ~0.85s OP_ANC Transparency transition completes).
        self._pending_trans_apply: str | None = None
        self._pending_trans_due = 0.0
        # MAC -> RFCOMM channels resolved via SDP (avoids 3 SDP round-trips per reconnect).
        self._channel_cache: dict[str, list[int]] = {}
        self._last_adaptive_check = 0.0
        self._last_saved_cfg: str | None = None
        self._stop_event = threading.Event()

        # Initialize state from persisted config so the UI always has rich context
        self.state: dict[str, Any] = {
            "connected": False,
            "bluetooth_connected": False,
            "usb_connected": False,
            "connection_type": "none",
            "rcsp_connected": False,
            "connecting": False,
            "name": self._cfg.get("name", protocol.DEVICE_NAME_DEFAULT),
            "mac": self._cfg.get("mac", ""),
            "model": protocol.MODEL_ID,
            "sale_model": protocol.SALE_MODEL,
            "vid": self._cfg.get("vid", "2717"),
            "pid": self._cfg.get("pid", "50f0"),
            "firmware": self._cfg.get("firmware"),
            "battery": self._cfg.get("last_battery"),
            "charging": False,
            "usb_charging": False,
            "usb_serial": None,
            "usb_max_power": None,
            "usb_sink_name": None,
            "usb_volume": None,
            "usb_muted": False,
            "usb_default_audio": False,
            "battery_source": self._cfg.get("battery_source"),
            "battery_left": None,
            "battery_right": None,
            "battery_case": None,
            "codec": None,
            "profile": None,
            # Noise Control
            "anc": self._cfg.get("anc", "off"),
            "anc_available": True,
            "anc_level": self._cfg.get("anc_level", "balanced"),
            "trans_level": self._cfg.get("trans_level", "regular"),
            "adaptive_anc": bool(self._cfg.get("adaptive_anc", False)),
            # Equalizer
            "eq": self._cfg.get("eq", "balanced"),
            "eq_available": True,
            "eq_bands": list(self._cfg.get("eq_bands") or [0] * 10),
            "eq_frequencies": list(protocol.EQ_FREQUENCIES),
            # Device Features
            "multipoint": bool(self._cfg.get("multipoint", False)),
            "game_mode": bool(self._cfg.get("game_mode", False)),
            "auto_answer": bool(self._cfg.get("auto_answer", False)),
            "ear_detection": bool(self._cfg.get("ear_detection", False)),
            "finding": False,
            # Button / MFB Controls
            "gestures": dict(DEFAULT_GESTURES, **(self._cfg.get("gestures") or {})),
            "anc_cycle": self._cfg.get("anc_cycle", "all"),
            # Paired Devices List
            "devices": [],
            "error": None,
        }
        self._bt_anc_cache: tuple[str, str, bool] = (
            str(self.state["anc"]),
            str(self.state["anc_level"]),
            bool(self.state["adaptive_anc"]),
        )
        self._bt_eq_cache: tuple[str, list[int]] = (
            str(self.state["eq"]),
            list(self.state["eq_bands"]),
        )
        self._bt_battery_cache: int | None = self.state.get("battery")
        if len(self.state["eq_bands"]) != 10:
            self.state["eq_bands"] = [0] * 10

    def _next_seq(self) -> int:
        with self._lock:
            val = self._seq
            self._seq = (self._seq + 1) & 0xFF
            return val

    def _persist_state(self) -> None:
        with self._lock:
            usb_only = bool(self.state.get("usb_connected")) and not bool(self.state.get("bluetooth_connected"))
            for key in (
                "mac",
                "name",
                "vid",
                "pid",
                "firmware",
                "anc",
                "anc_level",
                "trans_level",
                "adaptive_anc",
                "eq",
                "eq_bands",
                "multipoint",
                "game_mode",
                "auto_answer",
                "ear_detection",
                "gestures",
                "anc_cycle",
                "battery_source",
            ):
                if usb_only and key in ("anc", "anc_level", "adaptive_anc", "eq", "eq_bands"):
                    continue
                if self.state.get(key) is not None:
                    self._cfg[key] = self.state[key]
            if usb_only:
                self._cfg["anc"], self._cfg["anc_level"], self._cfg["adaptive_anc"] = self._bt_anc_cache
                self._cfg["eq"], self._cfg["eq_bands"] = self._bt_eq_cache[0], list(self._bt_eq_cache[1])
            if self.state.get("battery") is not None:
                self._cfg["last_battery"] = self.state["battery"]
                self._cfg["last_charging"] = bool(self.state.get("charging", False))
            serialized = json.dumps(self._cfg, sort_keys=True)
            if serialized == self._last_saved_cfg:
                # Unchanged: skip the temp-file + fsync that used to run on every poll/packet.
                return
            self._last_saved_cfg = serialized
            cfg_copy = dict(self._cfg)
        save_config(cfg_copy)

    def _snapshot_state(self) -> dict[str, Any]:
        """Returns a thread-safe deep snapshot of `self.state` for JSON serialization."""
        with self._lock:
            snap = dict(self.state)
            snap["eq_bands"] = list(self.state.get("eq_bands") or [0] * 10)
            snap["eq_frequencies"] = list(self.state.get("eq_frequencies") or protocol.EQ_FREQUENCIES)
            snap["gestures"] = dict(self.state.get("gestures") or DEFAULT_GESTURES)
            snap["devices"] = [dict(d) for d in (self.state.get("devices") or [])]
            return snap

    # ── BlueZ & USB System Refresh ──

    def refresh_bluez(self, force_codec: bool = False, min_interval: float = 0.0) -> None:
        with self._refresh_lock:
            now_check = time.monotonic()
            usb_dev = query_usb_redmi_neo()
            usb_connected = usb_dev is not None
            with self._lock:
                was_usb_connected = bool(self.state.get("usb_connected"))
                preferred_mac = (self.state.get("mac") or "").upper()

            usb_changed = usb_connected != was_usb_connected
            need_bluez = force_codec or usb_changed or min_interval <= 0.0 or (
                (now_check - self._last_bluez_refresh) >= min_interval
            )
            if need_bluez:
                self._last_bluez_refresh = now_check
                devices = query_bluez_devices()
                self._last_bluez_devices = devices
            else:
                devices = list(self._last_bluez_devices)

            chosen: dict[str, Any] | None = None
            # 1. Match preferred MAC if present
            if preferred_mac:
                for d in devices:
                    if d["mac"] == preferred_mac:
                        chosen = d
                        break

            # 2. Match connected REDMI Headphones Neo candidate
            if chosen is None:
                for d in devices:
                    if d.get("is_redmi_neo") and d.get("connected"):
                        chosen = d
                        break

            # 3. Match any paired REDMI Headphones Neo candidate
            if chosen is None:
                for d in devices:
                    if d.get("is_redmi_neo"):
                        chosen = d
                        break

            # 4. Fallback to first connected or paired device
            if chosen is None and devices:
                chosen = next((d for d in devices if d.get("connected")), devices[0])

            bt_connected = bool(chosen and chosen.get("connected"))
            audio_info: dict[str, str | None] | None = None
            usb_audio_info: dict[str, str | None] | None = None
            now = time.monotonic()

            if bt_connected and chosen is not None:
                if force_codec or (now - self._last_codec_check > 5.0):
                    self._last_codec_check = now
                    audio_info = query_audio_codec(chosen["mac"])

            if usb_connected:
                run_pactl = force_codec or usb_changed or (now - self._last_usb_audio_check > 5.0)
                if run_pactl:
                    self._last_usb_audio_check = now
                usb_audio_info = query_usb_audio_info(use_pactl=run_pactl)

            with self._lock:
                if need_bluez:
                    ui_devices = [
                        {
                            "mac": d["mac"],
                            "name": d["alias"] or d["name"],
                            "connected": d["connected"],
                            "is_redmi_neo": d["is_redmi_neo"],
                            "battery": (
                                d.get("bluez_battery")
                                if d.get("bluez_battery") is not None
                                else d.get("beacon_battery")
                            ),
                        }
                        for d in devices
                    ]
                    self.state["devices"] = ui_devices

                was_bt_connected = bool(self.state.get("bluetooth_connected"))
                now_connected = bt_connected or usb_connected
                if usb_connected and bt_connected:
                    conn_type = "usb+bluetooth"
                elif usb_connected:
                    conn_type = "usb"
                elif bt_connected:
                    conn_type = "bluetooth"
                else:
                    conn_type = "none"

                self.state["bluetooth_connected"] = bt_connected
                self.state["usb_connected"] = usb_connected
                self.state["connection_type"] = conn_type
                self.state["connected"] = now_connected
                self.state["usb_charging"] = usb_connected

                if usb_dev is not None:
                    self.state["usb_serial"] = usb_dev.get("serial")
                    self.state["usb_max_power"] = usb_dev.get("max_power")
                    if not self.state.get("name"):
                        self.state["name"] = usb_dev.get("product") or protocol.DEVICE_NAME_DEFAULT
                    if usb_dev.get("vid"):
                        self.state["vid"] = usb_dev["vid"]
                    if usb_dev.get("pid"):
                        self.state["pid"] = usb_dev["pid"]
                    if usb_changed:
                        self.state["error"] = None
                else:
                    self.state["usb_serial"] = None
                    self.state["usb_max_power"] = None
                    self.state["usb_sink_name"] = None
                    self.state["usb_volume"] = None
                    self.state["usb_muted"] = False
                    self.state["usb_default_audio"] = False
                    if usb_changed:
                        self.state["error"] = None

                # USB-C wired mode turns off ANC and defaults EQ to Balanced on the headset;
                # RCSP-only hardware controls are unavailable without Bluetooth.
                usb_only = usb_connected and not bt_connected
                if usb_only:
                    if not was_usb_connected or self.state.get("anc_available", True):
                        self._bt_anc_cache = (
                            str(self.state.get("anc") or "off"),
                            str(self.state.get("anc_level") or "balanced"),
                            bool(self.state.get("adaptive_anc", False)),
                        )
                        self._bt_eq_cache = (
                            str(self.state.get("eq") or "balanced"),
                            list(self.state.get("eq_bands") or [0] * 10),
                        )
                        if self.state.get("battery") is not None:
                            self._bt_battery_cache = int(self.state["battery"])
                    self.state["anc"] = "off"
                    self.state["adaptive_anc"] = False
                    self.state["anc_available"] = False
                    self.state["eq"] = "balanced"
                    self.state["eq_available"] = False
                    self.state["finding"] = False
                else:
                    was_unavailable = not bool(self.state.get("anc_available", True))
                    self.state["anc_available"] = True
                    self.state["eq_available"] = True
                    if was_unavailable and not self.state.get("rcsp_connected"):
                        self.state["anc"], self.state["anc_level"], self.state["adaptive_anc"] = self._bt_anc_cache
                        self.state["eq"], self.state["eq_bands"] = (
                            self._bt_eq_cache[0],
                            list(self._bt_eq_cache[1]),
                        )
                        if self.state.get("battery") is None and self._bt_battery_cache is not None:
                            self.state["battery"] = self._bt_battery_cache

                has_live_batt = False
                if chosen is not None:
                    mac = chosen["mac"]
                    self.state["mac"] = mac
                    self.state["name"] = chosen.get("alias") or chosen.get("name") or protocol.DEVICE_NAME_DEFAULT
                    if chosen.get("vid"):
                        self.state["vid"] = chosen["vid"]
                    if chosen.get("pid"):
                        self.state["pid"] = chosen["pid"]

                    # Update battery from BlueZ Battery1 or BLE ManufacturerData 0xFFFF beacon
                    # if RCSP hasn't provided a fresher reading while connected
                    if chosen.get("bluez_battery") is not None and not self.state.get("rcsp_connected"):
                        self.state["battery"] = chosen["bluez_battery"]
                        self._bt_battery_cache = int(chosen["bluez_battery"])
                        self.state["battery_source"] = "bluez"
                        has_live_batt = True
                    elif chosen.get("beacon_battery") is not None and (
                        self.state.get("battery") is None or not self.state.get("rcsp_connected")
                    ):
                        self.state["battery"] = chosen["beacon_battery"]
                        self._bt_battery_cache = int(chosen["beacon_battery"])
                        self.state["charging"] = bool(chosen.get("beacon_charging", False)) or usb_connected
                        self.state["battery_source"] = "beacon"
                        has_live_batt = True

                if not bt_connected:
                    self.state["rcsp_connected"] = False
                    if was_bt_connected:
                        self._close_rfcomm()
                    if not usb_connected:
                        self.state["finding"] = False

                if usb_connected and not self.state.get("rcsp_connected"):
                    self.state["charging"] = True
                    # Do not show stale pre-cable battery % as live while charging over USB-C
                    if not has_live_batt:
                        if self.state.get("battery") is not None:
                            self._bt_battery_cache = int(self.state["battery"])
                        self.state["battery"] = None
                        self.state["battery_source"] = "usb"

                if not now_connected:
                    self.state["codec"] = None
                    self.state["profile"] = None
                    self.state["finding"] = False
                    if not (chosen and chosen.get("beacon_battery") is not None):
                        self.state["charging"] = False
                        if self.state.get("battery_source") in ("usb", "usb_cached"):
                            self.state["battery_source"] = "cached" if self.state.get("battery") is not None else None
                else:
                    if bt_connected and audio_info is not None:
                        self.state["codec"] = audio_info.get("codec")
                        self.state["profile"] = audio_info.get("profile")
                    if usb_connected and usb_audio_info is not None:
                        if usb_audio_info.get("sink_name"):
                            self.state["usb_sink_name"] = usb_audio_info.get("sink_name")
                            self.state["usb_volume"] = usb_audio_info.get("volume")
                            self.state["usb_muted"] = bool(usb_audio_info.get("muted", False))
                            self.state["usb_default_audio"] = bool(usb_audio_info.get("is_default", False))
                        # Prefer Bluetooth codec when A2DP/HFP is active, otherwise report USB-C PCM format
                        if not bt_connected or not self.state.get("codec"):
                            self.state["codec"] = usb_audio_info.get("codec")
                            self.state["profile"] = usb_audio_info.get("profile")

                if bt_connected and chosen is not None:
                    mac = chosen["mac"]
                    if (
                        self._rfcomm_sock is None
                        and not self._connecting_rfcomm
                        and (now - self._last_rfcomm_attempt > 1.5)
                    ):
                        self._last_rfcomm_attempt = now
                        self._connecting_rfcomm = True
                        threading.Thread(
                            target=self._connect_rfcomm_worker,
                            args=(mac,),
                            daemon=True,
                        ).start()

        self._persist_state()

    # ── RFCOMM RCSP Transport ──

    def _close_rfcomm(self) -> None:
        with self._lock:
            sock = self._rfcomm_sock
            self._rfcomm_sock = None
            self._rfcomm_authenticated = False
            self._pending_reads.clear()
            self.state["rcsp_connected"] = False
        if sock is not None:
            try:
                sock.shutdown(socket.SHUT_RDWR)
            except Exception:
                pass
            try:
                sock.close()
            except Exception:
                pass

    def _resolve_rfcomm_candidates(self, mac: str) -> tuple[list[int], int | None]:
        """Resolves RFCOMM candidate channels exclusively for the Xiaomi RCSP/MMA control service."""
        with self._lock:
            cached = self._channel_cache.get(mac)
        if cached:
            return list(cached), None
        channels: list[int] = []
        for uuid_str in (
            protocol.UUID_MIUI_SPP,
            protocol.UUID_XIAOMI_MMA,
            protocol.UUID_VENDOR_SPEC,
        ):
            ch = sdp_find_rfcomm_channel(mac, uuid_str)
            if ch and ch not in channels:
                channels.append(ch)
        sdp_found = bool(channels)
        for fallback in (6, 24):
            if fallback not in channels:
                channels.append(fallback)
        if sdp_found:
            with self._lock:
                # Single-entry cache: only the currently selected headset is ever kept.
                self._channel_cache = {mac: list(channels)}
        return channels, None

    def _connect_rfcomm_worker(self, mac: str) -> None:
        try:
            candidates, _ = self._resolve_rfcomm_candidates(mac)
            connected_sock: socket.socket | None = None
            used_channel: int | None = None

            for attempt in range(3):
                for ch in candidates:
                    with self._lock:
                        if not self.state.get("bluetooth_connected") or self._stop_event.is_set():
                            return
                    s = socket.socket(socket.AF_BLUETOOTH, socket.SOCK_STREAM, socket.BTPROTO_RFCOMM)
                    try:
                        s.settimeout(2.2)
                        s.connect((mac, ch))
                        connected_sock = s
                        used_channel = ch
                        break
                    except OSError:
                        try:
                            s.close()
                        except Exception:
                            pass
                if connected_sock is not None:
                    break
                time.sleep(0.35)

            if connected_sock is None:
                # Channels may have moved (firmware update / re-pair): re-run SDP next time.
                with self._lock:
                    self._channel_cache.pop(mac, None)
                return

            with self._lock:
                stale = self._rfcomm_sock is not None or not self.state.get("bluetooth_connected")
                if not stale:
                    self._rfcomm_sock = connected_sock
                    self._rfcomm_mac = mac
                    self._rfcomm_channel = used_channel
                    self._rfcomm_is_fastpair = False
                    self.state["error"] = None
            if stale:
                try:
                    connected_sock.close()
                except Exception:
                    pass
                return

            # Perform SAFER+ authentication handshake + RCSP stream session
            self._run_rcsp_session(connected_sock, is_fastpair=False)
        except Exception:
            pass
        finally:
            with self._lock:
                self._connecting_rfcomm = False

    def _ensure_rcsp_ready(self, timeout: float = 1.5) -> bool:
        """Ensures the RCSP RFCOMM session is connected and authenticated before sending commands."""
        with self._lock:
            if self._rfcomm_sock is not None and self._rfcomm_authenticated:
                return True
            bt_connected = bool(self.state.get("bluetooth_connected"))
            mac = str(self.state.get("mac") or "").strip().upper()
            if not bt_connected or not mac:
                return False
            if self._rfcomm_sock is None and not self._connecting_rfcomm:
                self._last_rfcomm_attempt = time.monotonic()
                self._connecting_rfcomm = True
                threading.Thread(
                    target=self._connect_rfcomm_worker,
                    args=(mac,),
                    daemon=True,
                ).start()

        deadline = time.monotonic() + timeout
        while time.monotonic() < deadline:
            with self._lock:
                if self._rfcomm_sock is not None and self._rfcomm_authenticated:
                    return True
            time.sleep(0.05)
        with self._lock:
            return self._rfcomm_sock is not None

    def _require_rcsp_for_write(self, anc_action: bool = False) -> bool:
        """Verifies RCSP availability before modifying device settings, setting an honest error otherwise."""
        if self._ensure_rcsp_ready():
            return True
        with self._lock:
            if self.state.get("usb_connected") and not self.state.get("bluetooth_connected"):
                if anc_action:
                    self.state["error"] = "ANC cannot be used over USB-C cable — default mode is Off"
                else:
                    self.state["error"] = "USB-C cable mode: this setting requires Bluetooth"
            elif self.state.get("bluetooth_connected"):
                self.state["error"] = "Bluetooth RCSP session not ready yet — please retry"
            else:
                self.state["error"] = "Connect headphones via Bluetooth to change hardware settings"
        return False

    def _send_raw(self, data: bytes) -> bool:
        with self._lock:
            sock = self._rfcomm_sock
        if sock is None:
            return False
        try:
            sock.sendall(data)
            return True
        except OSError:
            self._close_rfcomm()
            return False

    def _send_read(self, build: Any, *args: Any) -> bool:
        """Sends a read request and records its send time so its answer can be aged later."""
        with self._lock:
            seq = self._next_seq()
            now = time.monotonic()
            # A seq slot is reused every 256 frames; drop anything older than 10 s so the
            # table stays bounded and a recycled seq can never inherit an ancient timestamp.
            if len(self._pending_reads) >= 32:
                for old_seq in [s for s, ts in self._pending_reads.items() if now - ts > 10.0]:
                    del self._pending_reads[old_seq]
            self._pending_reads[seq] = now
        return self._send_raw(build(seq, *args))

    def _send_reads(self, requests: list[tuple[Any, ...]], gap: float) -> None:
        for req in requests:
            if not self._send_read(*req):
                break
            time.sleep(gap)

    # Live mode/level/adaptive state is polled fast; slower-moving settings (battery, EQ,
    # toggles, MFB) are refreshed on every Nth poll so changes from the phone app or the
    # headset's own buttons still show up in the panel in real time.
    def _query_live_status(self, full: bool = False) -> None:
        reqs: list[tuple[Any, ...]] = [
            (protocol.build_get_config, protocol.CFG_ADAPTIVE_ANC),
            (protocol.build_get_config, protocol.CFG_EFFECT_STRENGTH),
            (protocol.build_get_config, protocol.CFG_TRANS_MODE),
        ]
        if full:
            reqs += [
                (protocol.build_get_device_info_mask, protocol.DEV_INFO_BIT_BATTERY),
                (protocol.build_get_config, protocol.CFG_EQ_PRESET),
                (protocol.build_get_config, protocol.CFG_EQ_CURVE),
                (protocol.build_get_config, protocol.CFG_MULTIPOINT),
                (protocol.build_get_config, protocol.CFG_GAME_MODE),
                (protocol.build_get_config, protocol.CFG_GESTURES),
                (protocol.build_get_config, protocol.CFG_ANC_CYCLE),
            ]
        self._send_reads(reqs, gap=0.02)

    def _query_initial_device_state(self) -> None:
        """Sends initial RCSP queries after connecting/authenticating."""
        # NOTE: DEV_INFO_BIT_ANC is deliberately not queried: on this headset it is a
        # constant capability flag, not the live mode (see protocol.parse_device_info_tlvs).
        self._send_reads(
            [
                (protocol.build_get_device_info_mask, protocol.DEV_INFO_BIT_BATTERY),
                (protocol.build_get_device_info_mask, protocol.DEV_INFO_BIT_FIRMWARE),
                (protocol.build_get_device_info_mask, protocol.DEV_INFO_BIT_VID_PID),
                (protocol.build_get_config, protocol.CFG_ADAPTIVE_ANC),
                (protocol.build_get_config, protocol.CFG_EFFECT_STRENGTH),
                (protocol.build_get_config, protocol.CFG_TRANS_MODE),
                (protocol.build_get_config, protocol.CFG_EQ_PRESET),
                (protocol.build_get_config, protocol.CFG_EQ_CURVE),
                (protocol.build_get_config, protocol.CFG_MULTIPOINT),
                (protocol.build_get_config, protocol.CFG_GAME_MODE),
                (protocol.build_get_config, protocol.CFG_GESTURES),
                (protocol.build_get_config, protocol.CFG_ANC_CYCLE),
            ],
            gap=0.025,
        )

    def _apply_parsed_updates(self, updates: dict[str, Any], from_rcsp: bool = True) -> None:
        if not updates:
            return
        with self._lock:
            if from_rcsp:
                self.state["rcsp_connected"] = True
            for k, v in updates.items():
                if k == "gestures" and isinstance(v, dict):
                    merged = dict(self.state.get("gestures") or DEFAULT_GESTURES)
                    merged.update(v)
                    self.state["gestures"] = merged
                elif v is not None:
                    self.state[k] = v
            if from_rcsp and "battery" in updates and updates["battery"] is not None:
                self.state["battery_source"] = "rcsp"
        self._persist_state()

    def _begin_write(self) -> None:
        """Marks a user write intent *before* the optimistic state update is applied."""
        with self._lock:
            self._last_write_ts = time.monotonic()

    def _mark_write_seq(self) -> int:
        with self._lock:
            seq = self._next_seq()
            self._last_write_ts = time.monotonic()
            return seq

    def _is_stale_response(self, pkt: protocol.RcspPacket) -> bool:
        """True if `pkt` answers a read that was sent before the latest user write."""
        if pkt.seq is None:
            return False
        with self._lock:
            sent_ts = self._pending_reads.pop(pkt.seq, None)
            if sent_ts is None:
                # Not one of our reads (e.g. the ACK of a SET): nothing to age.
                return False
            return sent_ts < self._last_write_ts

    def _maybe_query_adaptive_anc(self) -> None:
        """Rate-limited check of CFG_ADAPTIVE_ANC (0x25) after an unsolicited ANC level push."""
        now = time.monotonic()
        with self._lock:
            if not self._rfcomm_authenticated or not self.state.get("adaptive_anc"):
                return
            if (now - self._last_adaptive_check) < 0.5:
                return
            self._last_adaptive_check = now
        self._send_read(protocol.build_get_config, protocol.CFG_ADAPTIVE_ANC)

    def _handle_rcsp_packet(self, pkt: protocol.RcspPacket, auth: protocol.CommandAuthSession) -> None:
        # 1. Handle SAFER+ mutual authentication packets (0x50 / 0x51)
        if pkt.opcode in (protocol.OP_AUTH_CHALLENGE, protocol.OP_AUTH_CONFIRM):
            replies = auth.feed_packet(pkt)
            for rep in replies:
                self._send_raw(rep)
            if auth.authenticated and not self._rfcomm_authenticated:
                with self._lock:
                    self._rfcomm_authenticated = True
                    self.state["rcsp_connected"] = True
                self._query_initial_device_state()
            return

        # 2. Acknowledge device-initiated requests/notifications if required
        if pkt.expects_ack and pkt.seq is not None:
            self._send_raw(protocol.build_response(pkt.opcode, pkt.seq))

        # Ignore read responses that were requested prior to the latest user write command
        if pkt.is_response and self._is_stale_response(pkt):
            return

        # 3. Parse payload by opcode
        if pkt.opcode == protocol.OP_GET_DEVICE_INFO and pkt.is_response:
            info = protocol.parse_device_info_tlvs(pkt.payload)
            self._apply_parsed_updates(info, from_rcsp=True)

        elif pkt.opcode == protocol.OP_GET_RUN_INFO and pkt.is_response:
            info = protocol.parse_run_info_tlvs(pkt.payload)
            self._apply_parsed_updates(info, from_rcsp=True)

        elif pkt.opcode == protocol.OP_REPORT_STATUS and pkt.is_request_or_notify:
            info = protocol.parse_report_status_tlvs(pkt.payload)
            settled = (time.monotonic() - self._last_write_ts) >= self.DSP_SETTLE_SEC
            if not settled:
                for k in ("anc", "anc_level", "trans_level", "adaptive_anc"):
                    info.pop(k, None)
            self._apply_parsed_updates(info, from_rcsp=True)
            if settled and "anc_level" in info:
                self._maybe_query_adaptive_anc()

        elif pkt.opcode in (protocol.OP_GET_CONFIG, protocol.OP_NOTIFY_CONFIG):
            info = protocol.parse_config_records(pkt.payload)
            settled = (time.monotonic() - self._last_write_ts) >= self.DSP_SETTLE_SEC
            if pkt.is_request_or_notify and not settled:
                for k in ("anc", "anc_level", "trans_level", "adaptive_anc"):
                    info.pop(k, None)
            self._apply_parsed_updates(info, from_rcsp=True)
            if pkt.is_request_or_notify and settled and "anc_level" in info and "adaptive_anc" not in info:
                self._maybe_query_adaptive_anc()

    def _run_rcsp_session(self, sock: socket.socket, is_fastpair: bool = False) -> None:
        parser = protocol.RcspStreamParser()
        fp_parser = protocol.FastPairStreamParser() if is_fastpair else None
        with self._lock:
            self._seq = 0
            self._pending_reads.clear()
        auth = protocol.CommandAuthSession(self._next_seq)

        if not is_fastpair:
            # Start SAFER+ mutual authentication handshake on MIUI RCSP channel
            self._send_raw(auth.start())
        sock.settimeout(0.4)
        queried_fallback = is_fastpair
        start_ts = time.monotonic()
        last_live_poll = start_ts
        poll_tick = 0
        got_valid_packet = False

        try:
            while not self._stop_event.is_set():
                with self._lock:
                    if self._rfcomm_sock is not sock:
                        break
                try:
                    chunk = sock.recv(512)
                    if not chunk:
                        break
                    if is_fastpair and fp_parser is not None and protocol.FRAME_HEAD not in chunk:
                        fp_updates = fp_parser.feed(chunk)
                        if fp_updates:
                            self._apply_parsed_updates(fp_updates, from_rcsp=False)
                    else:
                        for pkt in parser.feed(chunk):
                            got_valid_packet = True
                            self._handle_rcsp_packet(pkt, auth)
                except socket.timeout:
                    pass
                except OSError:
                    break

                now = time.monotonic()
                deferred_trans: str | None = None
                with self._lock:
                    if self._pending_trans_apply is not None and now >= self._pending_trans_due:
                        if self.state.get("anc") == "transparency":
                            deferred_trans = self._pending_trans_apply
                        self._pending_trans_apply = None
                if deferred_trans is not None and self._rfcomm_authenticated:
                    self._send_raw(protocol.build_set_trans_level(self._mark_write_seq(), deferred_trans))
                    self._touch_write_ts()
                    now = time.monotonic()

                if not is_fastpair and not self._rfcomm_authenticated and not got_valid_packet and (now - start_ts >= 4.0):
                    # Connected to a non-RCSP RFCOMM channel (e.g. vendor channel) or stale peer; drop and retry.
                    break
                if not self._rfcomm_authenticated and not queried_fallback and (now - start_ts >= 1.0):
                    queried_fallback = True
                    self._query_initial_device_state()
                elif self._rfcomm_authenticated:
                    if (now - last_live_poll >= 1.5) and (now - self._last_write_ts >= self.POLL_QUIET_AFTER_WRITE_SEC):
                        last_live_poll = now
                        poll_tick += 1
                        self._query_live_status(full=(poll_tick % 4 == 0))
                elif is_fastpair:
                    sock.settimeout(4.0)
        finally:
            with self._lock:
                if self._rfcomm_sock is sock:
                    self._close_rfcomm()

    # ── User Commands from CLI / QML Panel ──

    def _touch_write_ts(self) -> None:
        with self._lock:
            self._last_write_ts = time.monotonic()

    def handle_command(self, req: dict[str, Any]) -> dict[str, Any]:
        cmd = str(req.get("cmd") or "state")

        if cmd == "state":
            self.refresh_bluez(force_codec=False, min_interval=2.5)
            return self._snapshot_state()

        if cmd == "poll":
            with self._lock:
                self.state["error"] = None
            self.refresh_bluez(force_codec=True)
            if (time.monotonic() - self._last_write_ts) >= self.POLL_QUIET_AFTER_WRITE_SEC:
                if self._ensure_rcsp_ready(timeout=1.2):
                    self._query_initial_device_state()
                    time.sleep(0.35)
            return self._snapshot_state()

        if cmd == "scan":
            self.refresh_bluez(force_codec=True)
            snap = self._snapshot_state()
            return {"devices": snap["devices"], "mac": snap["mac"]}

        if cmd == "use":
            mac = str(req.get("mac") or "").strip().upper()
            if mac:
                with self._lock:
                    if self.state.get("mac") != mac:
                        self._close_rfcomm()
                    self.state["mac"] = mac
                self.refresh_bluez(force_codec=True)
            return self._snapshot_state()

        if cmd in ("connect", "disconnect"):
            want_connect = cmd == "connect"
            self.refresh_bluez(force_codec=False, min_interval=1.0)
            with self._lock:
                mac = str(req.get("mac") or self.state.get("mac") or "").strip().upper()
                usb_only = bool(self.state.get("usb_connected")) and not bool(self.state.get("bluetooth_connected"))
                if not want_connect and usb_only:
                    self.state["connecting"] = False
                    self.state["error"] = "Connected via USB-C cable — unplug cable to disconnect"
                    return self._snapshot_state()
                self.state["connecting"] = True
                self.state["error"] = None
            if not mac:
                with self._lock:
                    self.state["connecting"] = False
                    self.state["error"] = "No REDMI Headphones Neo MAC configured"
                return self._snapshot_state()

            if not want_connect:
                self._close_rfcomm()

            ok, err = bluez_connect_device(mac, want_connect)
            time.sleep(0.35)
            self.refresh_bluez(force_codec=True)
            if want_connect and ok:
                self._ensure_rcsp_ready(timeout=1.5)
            with self._lock:
                self.state["connecting"] = False
                if not ok and err:
                    self.state["error"] = err
            return self._snapshot_state()

        if cmd == "anc":
            with self._write_lock:
                mode = str(req.get("mode") or "").lower()
                if mode == "on":
                    mode = "anc"
                elif mode == "cycle":
                    with self._lock:
                        cur_mode = str(self.state.get("anc") or "off")
                    order = ("off", "anc", "transparency")
                    mode = order[(order.index(cur_mode) + 1) % len(order)] if cur_mode in order else "anc"
                if mode in protocol.ANC_MODE_TO_BYTE:
                    if not self._require_rcsp_for_write(anc_action=True):
                        return self._snapshot_state()
                    with self._lock:
                        self._begin_write()
                        need_trans_defer = mode == "transparency" and self.state.get("anc") != "transparency"
                        self.state["anc"] = mode
                        self.state["error"] = None
                        anc_lvl = str(self.state.get("anc_level") or "balanced")
                        trans_lvl = str(self.state.get("trans_level") or "regular")
                        adaptive = bool(self.state.get("adaptive_anc"))
                        if mode == "transparency" and trans_lvl in protocol.TRANS_LEVEL_TO_BYTE:
                            if need_trans_defer:
                                self._pending_trans_apply = trans_lvl
                                self._pending_trans_due = time.monotonic() + 0.9
                        else:
                            self._pending_trans_apply = None
                    self._send_raw(protocol.build_set_anc_mode(self._mark_write_seq(), mode))
                    if mode == "anc":
                        time.sleep(0.05)
                        self._send_raw(protocol.build_set_adaptive_anc(self._mark_write_seq(), adaptive))
                        time.sleep(0.03)
                        eff_lvl = (
                            "adaptive"
                            if adaptive
                            else (anc_lvl if anc_lvl in protocol.ANC_LEVEL_TO_BYTE else "balanced")
                        )
                        self._send_raw(protocol.build_set_anc_level(self._mark_write_seq(), eff_lvl))
                    elif (
                        mode == "transparency"
                        and not need_trans_defer
                        and trans_lvl in protocol.TRANS_LEVEL_TO_BYTE
                    ):
                        time.sleep(0.05)
                        self._send_raw(protocol.build_set_trans_level(self._mark_write_seq(), trans_lvl))
                    self._touch_write_ts()
                    self._persist_state()
            return self._snapshot_state()

        if cmd == "anc-level":
            level = str(req.get("level") or "").lower()
            if level in protocol.ANC_LEVEL_TO_BYTE:
                with self._write_lock:
                    if not self._require_rcsp_for_write(anc_action=True):
                        return self._snapshot_state()
                    with self._lock:
                        self._begin_write()
                        self._pending_trans_apply = None
                        need_anc_mode = self.state.get("anc") != "anc"
                        want_adaptive = level == "adaptive"
                        self.state["anc"] = "anc"
                        if not want_adaptive:
                            self.state["anc_level"] = level
                        self.state["adaptive_anc"] = want_adaptive
                        self.state["error"] = None
                    if need_anc_mode:
                        self._send_raw(protocol.build_set_anc_mode(self._mark_write_seq(), "anc"))
                        time.sleep(0.05)
                    self._send_raw(protocol.build_set_adaptive_anc(self._mark_write_seq(), want_adaptive))
                    time.sleep(0.03)
                    self._send_raw(protocol.build_set_anc_level(self._mark_write_seq(), level))
                    self._touch_write_ts()
                    self._persist_state()
            return self._snapshot_state()

        if cmd == "trans-level":
            level = str(req.get("level") or "").lower()
            if level in protocol.TRANS_LEVEL_TO_BYTE:
                with self._write_lock:
                    if not self._require_rcsp_for_write(anc_action=True):
                        return self._snapshot_state()
                    with self._lock:
                        self._begin_write()
                        need_trans_mode = self.state.get("anc") != "transparency"
                        self.state["anc"] = "transparency"
                        self.state["trans_level"] = level
                        self.state["error"] = None
                        if need_trans_mode:
                            self._pending_trans_apply = level
                            self._pending_trans_due = time.monotonic() + 0.9
                        else:
                            self._pending_trans_apply = None
                    if need_trans_mode:
                        self._send_raw(protocol.build_set_anc_mode(self._mark_write_seq(), "transparency"))
                    else:
                        self._send_raw(protocol.build_set_trans_level(self._mark_write_seq(), level))
                    self._touch_write_ts()
                    self._persist_state()
            return self._snapshot_state()

        if cmd == "adaptive-anc":
            enabled = bool(req.get("enabled"))
            with self._write_lock:
                if not self._require_rcsp_for_write(anc_action=True):
                    return self._snapshot_state()
                with self._lock:
                    self._begin_write()
                    if enabled:
                        self._pending_trans_apply = None
                    need_anc_mode = self.state.get("anc") != "anc"
                    if need_anc_mode and enabled:
                        self.state["anc"] = "anc"
                    self.state["adaptive_anc"] = enabled
                    lvl = str(self.state.get("anc_level") or "balanced")
                    if lvl not in ("light", "balanced", "deep"):
                        lvl = "balanced"
                        self.state["anc_level"] = lvl
                    self.state["error"] = None
                if need_anc_mode and enabled:
                    self._send_raw(protocol.build_set_anc_mode(self._mark_write_seq(), "anc"))
                    time.sleep(0.05)
                self._send_raw(protocol.build_set_adaptive_anc(self._mark_write_seq(), enabled))
                time.sleep(0.03)
                if enabled:
                    self._send_raw(protocol.build_set_anc_level(self._mark_write_seq(), "adaptive"))
                else:
                    self._send_raw(protocol.build_set_anc_level(self._mark_write_seq(), lvl))
                self._touch_write_ts()
                self._persist_state()
            return self._snapshot_state()

        if cmd == "eq":
            preset = str(req.get("preset") or "").lower()
            if preset in protocol.EQ_PRESET_TO_BYTE:
                with self._write_lock:
                    if not self._require_rcsp_for_write():
                        return self._snapshot_state()
                    with self._lock:
                        self._begin_write()
                        self.state["eq"] = preset
                        self.state["error"] = None
                        bands = list(self.state.get("eq_bands") or [0] * 10)
                    self._send_raw(protocol.build_set_eq_preset(self._mark_write_seq(), preset))
                    if preset == "custom":
                        time.sleep(0.03)
                        self._send_raw(protocol.build_set_eq_curve(self._mark_write_seq(), bands))
                    self._touch_write_ts()
                    self._persist_state()
            return self._snapshot_state()

        if cmd == "eq-bands":
            raw_bands = req.get("bands")
            if isinstance(raw_bands, list) and len(raw_bands) == 10:
                bands = [max(protocol.EQ_GAIN_MIN, min(protocol.EQ_GAIN_MAX, int(round(float(x))))) for x in raw_bands]
                with self._write_lock:
                    if not self._require_rcsp_for_write():
                        return self._snapshot_state()
                    with self._lock:
                        self._begin_write()
                        self.state["eq_bands"] = bands
                        self.state["eq"] = "custom"
                        self.state["error"] = None
                    self._send_raw(protocol.build_set_eq_preset(self._mark_write_seq(), "custom"))
                    time.sleep(0.02)
                    self._send_raw(protocol.build_set_eq_curve(self._mark_write_seq(), bands))
                    self._touch_write_ts()
                    self._persist_state()
            return self._snapshot_state()

        if cmd == "eq-reset":
            bands = [0] * 10
            with self._write_lock:
                if not self._require_rcsp_for_write():
                    return self._snapshot_state()
                with self._lock:
                    self._begin_write()
                    is_custom = self.state.get("eq") == "custom"
                    self.state["eq_bands"] = bands
                    self.state["error"] = None
                if not self._rfcomm_is_fastpair:
                    self._send_raw(protocol.build_eq_reset(self._mark_write_seq()))
                    if is_custom:
                        time.sleep(0.03)
                        self._send_raw(protocol.build_set_eq_curve(self._mark_write_seq(), bands))
                    self._touch_write_ts()
                self._persist_state()
            return self._snapshot_state()

        if cmd == "multipoint":
            enabled = bool(req.get("enabled"))
            with self._write_lock:
                if not self._require_rcsp_for_write():
                    return self._snapshot_state()
                with self._lock:
                    self._begin_write()
                    self.state["multipoint"] = enabled
                    self.state["error"] = None
                self._send_raw(protocol.build_set_multipoint(self._mark_write_seq(), enabled))
                self._touch_write_ts()
                self._persist_state()
            return self._snapshot_state()

        if cmd == "game-mode":
            enabled = bool(req.get("enabled"))
            with self._write_lock:
                if not self._require_rcsp_for_write():
                    return self._snapshot_state()
                with self._lock:
                    self._begin_write()
                    self.state["game_mode"] = enabled
                    self.state["error"] = None
                self._send_raw(protocol.build_set_game_mode(self._mark_write_seq(), enabled))
                self._touch_write_ts()
                self._persist_state()
            return self._snapshot_state()

        if cmd == "auto-answer":
            enabled = bool(req.get("enabled"))
            with self._write_lock:
                if not self._require_rcsp_for_write():
                    return self._snapshot_state()
                with self._lock:
                    self._begin_write()
                    self.state["auto_answer"] = enabled
                    self.state["error"] = None
                self._send_raw(protocol.build_set_auto_answer(self._mark_write_seq(), enabled))
                self._touch_write_ts()
                self._persist_state()
            return self._snapshot_state()

        if cmd == "ear-detection":
            enabled = bool(req.get("enabled"))
            with self._write_lock:
                if not self._require_rcsp_for_write():
                    return self._snapshot_state()
                with self._lock:
                    self._begin_write()
                    self.state["ear_detection"] = enabled
                    self.state["error"] = None
                self._send_raw(protocol.build_set_ear_detection(self._mark_write_seq(), enabled))
                self._touch_write_ts()
                self._persist_state()
            return self._snapshot_state()

        if cmd == "find":
            enabled = bool(req.get("enabled"))
            with self._write_lock:
                if not self._require_rcsp_for_write():
                    return self._snapshot_state()
                with self._lock:
                    self._begin_write()
                    self.state["finding"] = enabled
                    self.state["error"] = None
                if self._rfcomm_is_fastpair:
                    self._send_raw(protocol.build_fastpair_ring(enabled))
                else:
                    self._send_raw(protocol.build_set_find_device(self._mark_write_seq(), enabled))
                self._touch_write_ts()
            return self._snapshot_state()

        if cmd == "gesture":
            slot = str(req.get("slot") or "").lower()
            action = str(req.get("action") or "").lower()
            if slot in protocol.GESTURE_SLOT_TO_BYTE and action in protocol.GESTURE_ACTION_TO_BYTE:
                with self._write_lock:
                    if not self._require_rcsp_for_write():
                        return self._snapshot_state()
                    with self._lock:
                        self._begin_write()
                        gestures = dict(self.state.get("gestures") or DEFAULT_GESTURES)
                        gestures[slot] = action
                        self.state["gestures"] = gestures
                        self.state["error"] = None
                    self._send_raw(protocol.build_set_gesture(self._mark_write_seq(), slot, action))
                    self._touch_write_ts()
                    self._persist_state()
            return self._snapshot_state()

        if cmd == "anc-cycle":
            cycle_mode = str(req.get("mode") or "").lower()
            if cycle_mode in protocol.ANC_CYCLE_TO_BYTE:
                with self._write_lock:
                    if not self._require_rcsp_for_write():
                        return self._snapshot_state()
                    with self._lock:
                        self._begin_write()
                        self.state["anc_cycle"] = cycle_mode
                        self.state["error"] = None
                    self._send_raw(protocol.build_set_anc_cycle(self._mark_write_seq(), cycle_mode))
                    self._touch_write_ts()
                    self._persist_state()
            return self._snapshot_state()

        if cmd == "usb-volume":
            with self._lock:
                sink = self.state.get("usb_sink_name")
            if sink and "volume" in req:
                pct = max(0, min(100, int(round(float(req["volume"])))))
                try:
                    proc = subprocess.run(
                        ["pactl", "set-sink-volume", str(sink), f"{pct}%"],
                        capture_output=True,
                        text=True,
                        timeout=1.5,
                        check=False,
                    )
                    if proc.returncode == 0:
                        with self._lock:
                            self.state["usb_volume"] = pct
                            self.state["error"] = None
                except Exception:
                    pass
            return self._snapshot_state()

        if cmd == "usb-mute":
            with self._lock:
                sink = self.state.get("usb_sink_name")
                cur_muted = bool(self.state.get("usb_muted", False))
            if sink:
                val = req.get("muted")
                arg = ("1" if bool(val) else "0") if val is not None else "toggle"
                try:
                    proc = subprocess.run(
                        ["pactl", "set-sink-mute", str(sink), arg],
                        capture_output=True,
                        text=True,
                        timeout=1.5,
                        check=False,
                    )
                    if proc.returncode == 0:
                        with self._lock:
                            self.state["usb_muted"] = (not cur_muted) if val is None else bool(val)
                            self.state["error"] = None
                except Exception:
                    pass
            return self._snapshot_state()

        if cmd == "usb-set-default":
            with self._lock:
                sink = self.state.get("usb_sink_name")
            if sink:
                try:
                    proc = subprocess.run(
                        ["pactl", "set-default-sink", str(sink)],
                        capture_output=True,
                        text=True,
                        timeout=1.5,
                        check=False,
                    )
                    if proc.returncode == 0:
                        with self._lock:
                            self.state["usb_default_audio"] = True
                            self.state["error"] = None
                except Exception:
                    pass
            return self._snapshot_state()

        if cmd == "quit":
            self._stop_event.set()
            return {"ok": True}

        return self._snapshot_state()


# ── Unix Socket Server Loop ──

def _handle_client(conn: socket.socket, daemon: RedmiNeoDaemon) -> None:
    try:
        if not verify_peer_uid(conn):
            return
        conn.settimeout(2.0)
        raw = b""
        while len(raw) < 65536:
            chunk = conn.recv(4096)
            if not chunk:
                break
            raw += chunk
            if b"\n" in raw:
                break
        if not raw:
            return
        line = raw.split(b"\n", 1)[0].decode("utf-8", errors="replace").strip()
        req = json.loads(line) if line else {"cmd": "state"}
        resp = daemon.handle_command(req if isinstance(req, dict) else {"cmd": "state"})
        out = (json.dumps(resp, separators=(",", ":")) + "\n").encode("utf-8")
        conn.sendall(out)
    except Exception as exc:
        try:
            err_payload = json.dumps({"error": str(exc)}) + "\n"
            conn.sendall(err_payload.encode("utf-8"))
        except Exception:
            pass
    finally:
        try:
            conn.close()
        except Exception:
            pass


def _code_mtimes() -> tuple[int, int]:
    try:
        m1 = Path(__file__).stat().st_mtime_ns
        m2 = Path(protocol.__file__).stat().st_mtime_ns
        return (m1, m2)
    except OSError:
        return (0, 0)


def run_server() -> int:
    try:
        signal.signal(signal.SIGHUP, signal.SIG_IGN)
        signal.signal(signal.SIGPIPE, signal.SIG_IGN)
    except Exception:
        pass
    sock_path = runtime_socket_path()
    sock_path.parent.mkdir(parents=True, exist_ok=True)

    # Check if an existing instance is already listening
    if sock_path.exists():
        probe = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        try:
            probe.settimeout(0.5)
            probe.connect(str(sock_path))
            probe.close()
            return 0
        except OSError:
            try:
                if not sock_path.is_symlink():
                    sock_path.unlink()
            except OSError:
                pass
        finally:
            try:
                probe.close()
            except Exception:
                pass

    boot_mtimes = _code_mtimes()
    daemon = RedmiNeoDaemon()

    def _request_shutdown(_signum: int, _frame: Any) -> None:
        daemon._stop_event.set()

    try:
        signal.signal(signal.SIGTERM, _request_shutdown)
        signal.signal(signal.SIGINT, _request_shutdown)
    except Exception:
        pass

    daemon.refresh_bluez(force_codec=True)

    server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    old_umask = os.umask(0o177)
    try:
        server.bind(str(sock_path))
        os.chmod(str(sock_path), 0o600)
    finally:
        os.umask(old_umask)

    server.listen(16)
    server.settimeout(1.5)

    executor = concurrent.futures.ThreadPoolExecutor(max_workers=4, thread_name_prefix="redmid-ipc")
    last_bg_refresh = time.monotonic()
    try:
        while not daemon._stop_event.is_set():
            try:
                conn, _ = server.accept()
                try:
                    executor.submit(_handle_client, conn, daemon)
                except RuntimeError:
                    try:
                        conn.close()
                    except Exception:
                        pass
            except socket.timeout:
                pass
            except KeyboardInterrupt:
                break

            now = time.monotonic()
            if now - last_bg_refresh >= 4.0:
                last_bg_refresh = now
                if boot_mtimes != (0, 0) and _code_mtimes() != boot_mtimes:
                    # Plugin files updated on disk; exit cleanly so next redmictl starts fresh code
                    daemon._stop_event.set()
                    break
                try:
                    executor.submit(daemon.refresh_bluez, False, 3.5)
                except RuntimeError:
                    pass
    finally:
        daemon._stop_event.set()
        daemon._close_rfcomm()
        executor.shutdown(wait=False, cancel_futures=True)
        try:
            server.close()
        except Exception:
            pass
        try:
            if sock_path.exists() and not sock_path.is_symlink():
                sock_path.unlink()
        except Exception:
            pass
    return 0


if __name__ == "__main__":
    sys.exit(run_server())
